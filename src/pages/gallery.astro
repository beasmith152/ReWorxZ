		<script>
			// Carousel and Lightbox functionality
			const carousel = document.getElementById('galleryCarousel');
			const carouselImages = document.querySelectorAll('#galleryCarousel img');
			const carouselPrevBtn = document.getElementById('carouselPrevBtn');
			const carouselNextBtn = document.getElementById('carouselNextBtn');
			
			const lightboxModal = document.getElementById('lightboxModal');
			const lightboxImage = document.getElementById('lightboxImage');
			const closeModal = document.getElementById('closeModal');
			const prevBtn = document.getElementById('prevBtn');
			const nextBtn = document.getElementById('nextBtn');
			const imageCounter = document.getElementById('imageCounter');
			const totalImages = document.getElementById('totalImages');

			let currentLightboxIndex = 0;
			let carouselOffset = 0;
			const imagesPerView = 5;
			const images = Array.from(carouselImages).map(img => img.src);
			const maxOffset = Math.max(0, images.length - imagesPerView);
			
			totalImages.textContent = images.length;

			// Carousel navigation
			carouselPrevBtn.addEventListener('click', () => {
				if (carouselOffset > 0) {
					carouselOffset--;
					updateCarouselPosition();
				}
			});

			carouselNextBtn.addEventListener('click', () => {
				if (carouselOffset < maxOffset) {
					carouselOffset++;
					updateCarouselPosition();
				}
			});

			function updateCarouselPosition() {
				const imageWidth = 100 / imagesPerView; // Each image is 20% width
				const gapSize = 0.75; // gap-3 is ~0.75rem, adjust for translation
				const offset = carouselOffset * (imageWidth + gapSize / 12);
				carousel.style.transform = `translateX(-${offset}%)`;
			}

			// Open lightbox on image click
			carouselImages.forEach((img) => {
				img.addEventListener('click', (e) => {
					currentLightboxIndex = parseInt(e.target.getAttribute('data-index'));
					showImage(currentLightboxIndex);
					lightboxModal.classList.remove('hidden');
				});
			});

			// Close modal
			closeModal.addEventListener('click', closeLightbox);
			lightboxModal.addEventListener('click', (e) => {
				if (e.target === lightboxModal) closeLightbox();
			});

			// Lightbox navigation
			prevBtn.addEventListener('click', () => {
				currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
				showImage(currentLightboxIndex);
			});

			nextBtn.addEventListener('click', () => {
				currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
				showImage(currentLightboxIndex);
			});

			// Keyboard navigation
			document.addEventListener('keydown', (e) => {
				if (lightboxModal.classList.contains('hidden')) return;
				if (e.key === 'ArrowLeft') {
					currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
					showImage(currentLightboxIndex);
				} else if (e.key === 'ArrowRight') {
					currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
					showImage(currentLightboxIndex);
				} else if (e.key === 'Escape') {
					closeLightbox();
				}
			});

			function showImage(index) {
				lightboxImage.src = images[index];
				imageCounter.textContent = index + 1;
			}

			function closeLightbox() {
				lightboxModal.classList.add('hidden');
			}
		</script>
	</body>
