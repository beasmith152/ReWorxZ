  <div class="contact-intro">
    <h2 class="contact-title">Design Inquiry & Other Requests</h2>
    <p class="contact-description">
      Fill out the form below and we'll get back to you as soon as possible.If requesting a design also submit the design form below with your reference images at this link here: <a href="https://docs.google.com/forms/d/e/1FAIpQLSdvlbjW7cyNqnymbGPEXRpY0Z3-NYAKtlWWFNLJW7ZKWqhgew/viewform?usp=dialog" class="text-yellow-600">Design Inquiry Submission</a>
   <br /> <br />Download the form here: <a href="/forms/DRF.pdf" download="DesignContract" class="text-yellow-600">Design Inquiry Form</a>
	</p>
  </div>

  <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">

    <input type="hidden" name="access_key" value="685ab6f8-356b-430b-ab1e-220d1aad1b66" />
    <input type="hidden" name="subject" value="New Contact Form Submission from Web3Forms" />
    <input type="hidden" name="from_name" value="My Website" />
	<input type="hidden" name="redirect" value="https://re-worx-z.vercel.app/contactcopy">

    <!-- More custom ization options available in the docs: https://docs.web3forms.com -->

    <div class="form-group-container">
      <div class="form-group">
        <label for="name" class="form-label">Name</label>
        <input id="name" name="name" class="form-input w-full" placeholder="Your name" type="text" />
      </div>
      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" class="form-input w-full" placeholder="Your email" type="email" />
      </div>
      <div class="form-group">
        <label for="phone" class="form-label">Phone</label>
        <input id="phone" name="phone" class="form-input w-full" placeholder="+1 (234) 56789" type="text" />
      </div>
      <div class="form-group">
        <label for="message" class="form-label">Additional Notes or Comments</label>
        <textarea class="form-textarea w-full" id="message" name="message" placeholder="Your message"></textarea>
      </div>
    </div>
    <button class="form-submit" type="submit">Submit</button>
  </form>

